# ─────────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" (jamais commité) et remplissez les
# valeurs ci-dessous pour activer les emails automatiques Ascale.
# ─────────────────────────────────────────────────────────────────

# ── Envoi d'email via l'API Brevo (ex-Sendinblue) ─────────────
# Étapes :
#   1. Créez un compte gratuit sur https://www.brevo.com (300 emails/jour
#      gratuits, largement suffisant pour une démo)
#   2. Réglages (icône engrenage) → "Expéditeurs, domaines et dédiabolisation"
#      → ajoutez et vérifiez votre adresse d'envoi (email de confirmation
#      envoyé à cette adresse)
#   3. Réglages → "Clés API" → Générer une nouvelle clé API v3 → copiez-la ici
#
# Important : on utilise l'API HTTPS de Brevo (pas de SMTP direct) car
# beaucoup d'hébergeurs (dont le plan gratuit de Render) bloquent ou
# dégradent silencieusement les connexions SMTP sortantes.
# ─────────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-votre-cle-api

# Adresse d'envoi — DOIT être vérifiée dans Brevo (étape 2 ci-dessus)
BREVO_SENDER_EMAIL=votre.email@gmail.com

# Nom affiché dans le champ "De :"
BREVO_SENDER_NAME=Ascale Showroom

# ── Clé secrète Flask (sessions, CSRF) ────────────────────────
# Générez une valeur aléatoire : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-valeur-en-production

# ── WhatsApp Business API (Meta) — optionnel ─────────────────
# Obtenez ces valeurs depuis le portail Meta for Developers :
# https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=ascale-webhook-2026

# ── Chatbot LLM via OpenRouter (optionnel) ────────────────────
# Si renseigné, le chatbot appelle un LLM quand il ne connaît pas la réponse.
# Créez un compte gratuit sur https://openrouter.ai, puis copiez votre clé API.
# Sans cette clé, le chatbot affiche son message d'aide habituel en fallback.
OPENROUTER_API_KEY=
# Modèle à utiliser (le modèle ci-dessous est gratuit sur OpenRouter)
OPENROUTER_MODEL=minimax/minimax-m2.7:free
