# Copiez ce fichier en .env (déjà exclu de Git) et renseignez vos identifiants.
# Ne jamais committer le fichier .env réel.

# Exemple avec Gmail SMTP : utilisez un "mot de passe d'application" Gmail
# (pas votre mot de passe de compte habituel) — à générer sur
# https://myaccount.google.com/apppasswords une fois la validation en
# deux étapes activée sur le compte.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
