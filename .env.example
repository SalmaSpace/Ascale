# ─────────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" (jamais commité) et remplissez les
# valeurs ci-dessous pour activer les emails automatiques Ascale.
# ─────────────────────────────────────────────────────────────────

# ── SMTP Gmail (recommandé) ────────────────────────────────────
# Étapes pour créer un "Mot de passe d'application" Gmail :
#   1. Activez la validation en 2 étapes sur votre compte Google :
#      https://myaccount.google.com/signinoptions/twosv
#   2. Rendez-vous sur : https://myaccount.google.com/apppasswords
#   3. Choisissez "Application : Autre (nom personnalisé)" → "Ascale"
#   4. Google génère un mot de passe à 16 caractères → copiez-le ici
#
# ⚠️  N'utilisez PAS votre mot de passe Gmail habituel ici.
# ─────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Adresse Gmail expéditrice (ex: nasser.ascale@gmail.com)
MAIL_USERNAME=votre.email@gmail.com

# Mot de passe d'application à 16 caractères généré à l'étape 4
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Adresse affichée dans le champ "De :" (peut être identique à MAIL_USERNAME)
MAIL_DEFAULT_SENDER=Ascale Showroom <votre.email@gmail.com>

# ── Clé secrète Flask (sessions, CSRF) ────────────────────────
# Générez une valeur aléatoire : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-valeur-en-production

# ── WhatsApp Business API (Meta) — optionnel ─────────────────
# Obtenez ces valeurs depuis le portail Meta for Developers :
# https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=ascale-webhook-2026

# ── Chatbot LLM via OpenRouter (optionnel) ────────────────────
# Si renseigné, le chatbot appelle un LLM quand il ne connaît pas la réponse.
# Créez un compte gratuit sur https://openrouter.ai, puis copiez votre clé API.
# Sans cette clé, le chatbot affiche son message d'aide habituel en fallback.
OPENROUTER_API_KEY=
# Modèle à utiliser (le modèle ci-dessous est gratuit sur OpenRouter)
OPENROUTER_MODEL=minimax/minimax-m2.7:free
